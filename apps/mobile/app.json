{
  "expo": {
    "name": "NeowFocus",
    "slug": "neowfocus-mobile",
    "version": "0.1.0",
    "scheme": "neowfocus",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#272727",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.neowfocus.pomodorotimer",
      "appleTeamId": "L67FAG9382",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ]
  }
}
