+test("NeowFocus daily summaries appear alongside the selected calendar and open read-only", async () => {
+  const f = fixture();
+  const focus = { ...calendar("focus"), title: "냐우포커스" };
+  f.calendars.push(focus);
+  await f.store.selectCalendar(f.calendars[0], from, until);
+  const state = f.store.getSnapshot();
+  assert.equal(state.selected?.id, "a");
+  assert.equal(state.focusSnapshots.length, 1);
+  assert.equal(
+    connectedCalendarItemsOn(state.snapshot, state.focusSnapshots, "2026-10-02")
+      .length,
+    2,
+  );
+  await f.store.open(state.focusSnapshots[0].events[0]);
+  assert.equal(f.calls.opens.at(-1)?.editable, false);
+  await f.store.disconnect();
+  assert.equal(f.store.getSnapshot().focusSnapshots.length, 0);
+});
+
+test("selecting NeowFocus itself never duplicates its daily event", async () => {
+  const f = fixture();
+  f.calendars[0].title = "냐우포커스";
+  await f.store.selectCalendar(f.calendars[0], from, until);
+  const state = f.store.getSnapshot();
+  assert.equal(state.focusSnapshots.length, 0);
+  assert.equal(
+    connectedCalendarItemsOn(state.snapshot, state.focusSnapshots, "2026-10-02")
+      .length,
+    1,
+  );
+  await f.store.open(state.snapshot!.events[0]);
+  assert.equal(f.calls.opens.at(-1)?.editable, false);
+});
+
+test("automatic NeowFocus source ignores unmarked, timed and canceled events", async () => {
+  const f = fixture();
+  f.calendars.push({ ...calendar("focus"), title: "냐우포커스" });
+  f.adapter.events = async (id) =>
+    id !== "focus"
+      ? [event(id)]
+      : [
+          event(id),
+          event(id, { id: "personal", url: undefined }),
+          event(id, { id: "timed", allDay: false }),
+          event(id, { id: "canceled", status: "canceled" }),
+          event(id, { id: "another-app", url: "another://daily/2026-10-02" }),
+        ];
+  await f.store.selectCalendar(f.calendars[0], from, until);
+  assert.deepEqual(
+    f.store.getSnapshot().focusSnapshots[0].events.map((event) => event.id),
+    ["same-series"],
+  );
+});
+
+test("revoked permission and a background return fence focus-summary reads", async () => {
+  const f = fixture();
+  f.calendars.push({ ...calendar("focus"), title: "냐우포커스" });
+  await f.store.selectCalendar(f.calendars[0], from, until);
+  f.store.background();
+  assert.equal(f.store.getSnapshot().focusSnapshots.length, 0);
+  const pending = deferred<NativeEventInput[]>();
+  const entered = deferred<void>();
+  f.adapter.events = async (id) => {
+    if (id === "focus") {
+      entered.resolve();
+      return pending.promise;
+    }
+    return [event(id)];
+  };
+  const work = f.store.reloadCalendars();
+  await entered.promise;
+  f.permission({ status: "denied", canAskAgain: false });
+  pending.resolve([event("focus")]);
+  await work;
+  assert.equal(f.store.getSnapshot().focusSnapshots.length, 0);
+  assert.equal(f.store.getSnapshot().snapshot, undefined);
+});
+
