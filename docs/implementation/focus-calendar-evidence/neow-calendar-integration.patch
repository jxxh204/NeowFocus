+export function connectedCalendarItemsOn(
+  snapshot: NaverSnapshot | undefined,
+  focusSnapshots: NaverSnapshot[],
+  day: D.Day,
+) {
+  const items = [snapshot, ...focusSnapshots].flatMap((source) =>
+    naverItemsOn(source, day),
+  );
+  return [...new Map(items.map((item) => [item.event.id, item])).values()];
+}
